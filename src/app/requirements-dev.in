# Constrain to versions in the requirements.txt
-c requirements.txt

# develop branch of brewtils
-e git+https://github.com/beer-garden/brewtils@develop#egg=brewtils

# Documentation Dependencies
sphinx < 2
sphinx_rtd_theme < 1

# Build / Test Dependencies
black
codecov
coverage
flake8
flake8-bugbear
mock
pytest
pytest-mock
pytest-lazy-fixtures
pytest-tornado
isort < 8
wheel
testcontainers[mongodb]